# Environment variables for ncol-next.
# Only variables actually referenced in source code are listed.
# On Vercel these are managed via Dashboard → Settings → Environment Variables.

# ─── WordPress (headless CMS via WPGraphQL) ───────────────────────────
# WORDPRESS_API_URL: GraphQL endpoint (server-side)
# NEXT_PUBLIC_WORDPRESS_API_URL: same value, exposed to client hooks
# NEXT_PUBLIC_WORDPRESS_JSON_URL / WORDPRESS_JSON_URL: WP REST base for audio + sitemap
WORDPRESS_API_URL=
NEXT_PUBLIC_WORDPRESS_API_URL=
WORDPRESS_JSON_URL=
NEXT_PUBLIC_WORDPRESS_JSON_URL=
WORDPRESS_GRAPHQL_SECRET=
WORDPRESS_AUTH_REFRESH_TOKEN=
WP_USER=
WP_PASSWORD=
WP_PUSH_WEBHOOK_SECRET=

# ─── Opinion (WordPress REST endpoint for opinion articles) ───────────
WORDPRESS_OPINION_API_URL=
WORDPRESS_OPINION_API_SECRET=
OPINION_NOTIFICATION_EMAIL=

# ─── Supabase (shared auth project with ncol-legales) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Direct Postgres connection for ncol_tag_subscriptions (src/lib/db). Auth
# itself still goes through NEXT_PUBLIC_SUPABASE_URL above, not this.
SUPABASE_DATABASE_URL=

# ─── Turso / LibSQL (supplementary data) ──────────────────────────────
TURSO_DB_URL=
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_TURSO_VIEWS_URL=
NEXT_PUBLIC_TURSO_VIEWS_TOKEN=
TURSO_DOLAR_DB_URL=
TURSO_DOLAR_AUTH_TOKEN=
TURSO_HOROSCOPO_DB_URL=
TURSO_HOROSCOPO_AUTH_TOKEN=

# ─── AWS (Polly TTS + AudioBucket S3, remains on AWS) ─────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_AUDIO_BUCKET=
AWS_S3_AUDIO_BASE_URL=
AUDIO_SECRET=

# ─── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── OneSignal (push notifications for tag subscribers) ───────────────
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ─── Mailchimp (newsletter) ───────────────────────────────────────────
MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_AUDIENCE_ID=

# ─── Resend (transactional email) ─────────────────────────────────────
RESEND_API_KEY=

# ─── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Telegram (opinion pipeline notifications) ────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPINION_CHAT_ID=

# ─── Tinybird (ads analytics) ─────────────────────────────────────────
TINYBIRD_URL=
TINYBIRD_TOKEN=

# ─── Google AdSense ───────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_PUB_ID=

# ─── ISR revalidation (webhook secret) ────────────────────────────────
REVALIDATE_SECRET=

# ─── Feature flags / tunables ─────────────────────────────────────────
NEXT_PUBLIC_TAG_SUBSCRIBE_ONBOARDING_ENABLED=false
NEXT_PUBLIC_POSTS_QTY_CATEGORY=10
MOST_VISITED_DAYS=
